# ==========================================
# Aplicação
# ==========================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# ==========================================
# Banco de dados (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/validamed_cobranca?schema=public"

# ==========================================
# Redis (fila de envio - BullMQ)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# WhatsApp Business Cloud API (Meta)
# Número/chip novo cadastrado no Meta Business Manager
# ==========================================
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=coloque_o_phone_number_id_do_novo_numero
WHATSAPP_BUSINESS_ACCOUNT_ID=coloque_o_waba_id
WHATSAPP_ACCESS_TOKEN=coloque_o_token_permanente_da_meta
WHATSAPP_VERIFY_TOKEN=defina-uma-string-para-validar-o-webhook
# Nome do template aprovado na Meta para envio de cobrança (fora da janela de 24h)
WHATSAPP_TEMPLATE_NAME=cobranca_validamed
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# ==========================================
# SMS - Twilio (usando o mesmo número/chip novo, se habilitado para SMS,
# ou um número Twilio dedicado)
# ==========================================
TWILIO_ACCOUNT_SID=coloque_o_account_sid
TWILIO_AUTH_TOKEN=coloque_o_auth_token
TWILIO_FROM_NUMBER=+55DDD00000000
TWILIO_STATUS_CALLBACK_URL=${APP_URL}/webhooks/sms/twilio/status

# ==========================================
# E-mail (SMTP genérico)
# ==========================================
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cobranca@seudominio.com.br
SMTP_PASSWORD=coloque_a_senha_ou_app_password
SMTP_FROM_NAME=ValidaMed Cobrança
SMTP_FROM_EMAIL=cobranca@seudominio.com.br

# ==========================================
# Usuário administrador inicial (seed)
# ==========================================
SEED_ADMIN_EMAIL=admin@validamed.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha
