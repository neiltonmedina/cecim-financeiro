# ==========================================
# Aplicação
# ==========================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# ==========================================
# Banco de dados (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cecim_financeiro?schema=public"

# ==========================================
# Redis (fila de envio - BullMQ)
# Local/Docker: REDIS_TLS=false. Upstash ou outro provedor gerenciado: REDIS_TLS=true
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ==========================================
# WhatsApp Business Cloud API (Meta)
# Número/chip novo cadastrado no Meta Business Manager
# ==========================================
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=coloque_o_phone_number_id_do_novo_numero
WHATSAPP_BUSINESS_ACCOUNT_ID=coloque_o_waba_id
WHATSAPP_ACCESS_TOKEN=coloque_o_token_permanente_da_meta
WHATSAPP_VERIFY_TOKEN=defina-uma-string-para-validar-o-webhook
# Nome do template aprovado na Meta para envio de cobrança (fora da janela de 24h)
WHATSAPP_TEMPLATE_NAME=cobranca_cecim
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# ==========================================
# SMS - Twilio (usando o mesmo número/chip novo, se habilitado para SMS,
# ou um número Twilio dedicado)
# ==========================================
TWILIO_ACCOUNT_SID=coloque_o_account_sid
TWILIO_AUTH_TOKEN=coloque_o_auth_token
TWILIO_FROM_NUMBER=+55DDD00000000
TWILIO_STATUS_CALLBACK_URL=${APP_URL}/webhooks/sms/twilio/status

# ==========================================
# Emissão de boleto - API de Cobrança do Banco Inter (opcional)
# Se preenchido, toda cobrança criada já gera o boleto automaticamente.
# CERT/KEY: pegue o conteúdo dos arquivos .crt e .key gerados no Internet
# Banking Inter Empresas > API, e converta pra base64 (uma linha só):
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificado.crt"))
# ==========================================
INTER_CLIENT_ID=coloque_o_client_id_do_inter
INTER_CLIENT_SECRET=coloque_o_client_secret_do_inter
INTER_CERT_BASE64=
INTER_KEY_BASE64=
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
# Multa (%) e juros de mora mensal (%) aplicados a todo boleto - defina 0 para não cobrar
INTER_MULTA_PERCENTUAL=0
INTER_MORA_TAXA_MENSAL=0

# ==========================================
# Agente de cobrança conversacional (Claude / Anthropic)
# ==========================================
ANTHROPIC_API_KEY=coloque_sua_chave_da_anthropic
# E-mail que recebe o aviso quando o agente precisa encaminhar a conversa para um humano
ESCALATION_EMAIL=financeiro@seudominio.com.br

# ==========================================
# E-mail (SMTP genérico)
# ==========================================
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cobranca@seudominio.com.br
SMTP_PASSWORD=coloque_a_senha_ou_app_password
SMTP_FROM_NAME=CECIM Financeiro
SMTP_FROM_EMAIL=cobranca@seudominio.com.br

# ==========================================
# Usuário administrador inicial (seed)
# ==========================================
SEED_ADMIN_EMAIL=admin@cecim.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha
