generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERADOR
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

// Cliente que pode receber cobranças
model Client {
  id             String   @id @default(uuid())
  name           String
  document       String? // CPF/CNPJ
  email          String?
  phoneE164      String? // formato +5511999998888, usado para WhatsApp e SMS
  whatsappOptIn  Boolean  @default(true)
  smsOptIn       Boolean  @default(true)
  emailOptIn     Boolean  @default(true)
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  charges       Charge[]
  conversations Conversation[]

  @@index([name])
}

enum ChargeStatus {
  PENDENTE
  ENVIADA
  PAGA
  VENCIDA
  CANCELADA
}

// Cobrança emitida para um cliente
model Charge {
  id            String       @id @default(uuid())
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  description   String
  amountCents   Int
  dueDate       DateTime
  status        ChargeStatus @default(PENDENTE)
  paymentLink   String?
  externalRef   String? // referência ao boleto/pix/pedido no sistema de origem
  createdBy     String? // userId de quem criou
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  paidAt        DateTime?
  canceledAt    DateTime?

  notifications NotificationLog[]
  conversations Conversation[]
  agreements    Agreement[]

  @@index([status])
  @@index([dueDate])
}

enum TemplateType {
  COBRANCA_PENDENTE
  LEMBRETE_VENCIMENTO
  COBRANCA_VENCIDA
  CONFIRMACAO_PAGAMENTO
}

// Modelos de mensagem por canal, com placeholders {{cliente}}, {{valor}}, {{vencimento}}, {{linkPagamento}}, {{descricao}}
model MessageTemplate {
  id        String       @id @default(uuid())
  channel   Channel
  type      TemplateType
  name      String
  subject   String? // usado apenas em EMAIL
  body      String
  active    Boolean      @default(true)
  // nome do template pré-aprovado na Meta, obrigatório apenas para WHATSAPP fora da janela de 24h
  providerTemplateName String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([channel, type])
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

// Registro de cada tentativa de envio, por canal, para auditoria e status de entrega
model NotificationLog {
  id                String              @id @default(uuid())
  charge            Charge              @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  chargeId          String
  channel           Channel
  status            NotificationStatus  @default(QUEUED)
  destination       String // telefone E.164 ou e-mail usado no envio
  templateType      TemplateType
  providerMessageId String?
  errorMessage      String?
  attempt           Int                 @default(1)
  queuedAt          DateTime            @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?

  @@index([chargeId])
  @@index([channel, status])
  @@index([providerMessageId])
}

// Regras de lembrete automático (ex: 3 dias antes do vencimento, no dia, e 1/5 dias após vencida)
model ReminderRule {
  id          String   @id @default(uuid())
  name        String
  offsetDays  Int // negativo = antes do vencimento, positivo = depois (vencida)
  templateType TemplateType
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ==========================================================
// Agente de cobrança conversacional (WhatsApp)
// ==========================================================

enum ConversationStage {
  INICIADA             // 1ª mensagem enviada
  LEMBRETE_ENVIADO      // 2º contato (sem resposta ao 1º)
  TERCEIRA_TENTATIVA    // 3º contato, oferece negociação
  NEGOCIACAO            // cliente pediu negociação, em andamento
  AGUARDANDO_PAGAMENTO  // cliente avisou que vai pagar / já pagou, aguardando confirmação
  AGUARDANDO_HUMANO     // escalado, automação pausada
  ENCERRADA             // fim do fluxo automático (sem resposta após 3 tentativas, ou resolvido)
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Classificação da intenção da mensagem do cliente, feita pelo agente (Claude)
enum MessageIntent {
  JA_PAGOU
  VAI_PAGAR
  DATA_ESPECIFICA
  QUER_NEGOCIAR
  NAO_RECONHECE
  NAO_PODE_PAGAR
  PEDIU_BOLETO_PIX
  QUER_HUMANO
  OUTRO
}

// Uma conversa de cobrança por WhatsApp, vinculada a um cliente e (quando aplicável) a uma cobrança
model Conversation {
  id             String            @id @default(uuid())
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  charge         Charge?           @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  chargeId       String?
  stage          ConversationStage @default(INICIADA)
  humanRequested Boolean           @default(false)
  attemptCount   Int               @default(1)
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  messages   ConversationMessage[]
  agreements Agreement[]

  @@index([clientId])
  @@index([stage])
}

// Cada mensagem trocada (entrada do cliente ou saída do agente) dentro de uma conversa
model ConversationMessage {
  id             String            @id @default(uuid())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  direction      MessageDirection
  channel        Channel
  content        String
  intent         MessageIntent?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
}

// Política de negociação autorizada pela empresa - o agente NUNCA pode oferecer
// condições fora daqui. Mantemos um único registro ativo por padrão.
model NegotiationPolicy {
  id                 String   @id @default(uuid())
  name               String
  active             Boolean  @default(true)
  maxDiscountPercent Int      @default(0)
  maxInstallments    Int      @default(1)
  notes              String? // condições adicionais em texto livre, ex: "só à vista tem desconto"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Acordo/negociação confirmado com o cliente durante a conversa
model Agreement {
  id             String       @id @default(uuid())
  charge         Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  chargeId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  terms          String // descrição do acordo em texto (ex: "10% de desconto, pagamento até dia 20")
  discountPercent Int?
  installments    Int?
  confirmedAt    DateTime     @default(now())
}
